PORT=3000

# Register your own app at https://developers.deriv.com (Dashboard -> Register application)
# to get a real app_id before going anywhere near production. 1089 is Deriv's public demo
# app_id -- fine for local testing of market-data streaming, not for real users/trading.
DERIV_APP_ID=1089

# Must exactly match the Redirect URL you configure for the app in the Deriv dashboard.
OAUTH_REDIRECT_URL=http://localhost:3000/redirect.html
