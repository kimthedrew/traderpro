PORT=3000

# Register an app at https://developers.deriv.com (Dashboard -> Register application)
# and use the App ID it gives you -- Deriv's dashboard calls it "App ID" but it's really
# an OAuth2 client_id. Required for login; the public ticker feed needs no app_id at all.
# There is no working shared/demo app_id for this -- register your own, even for local dev.
DERIV_APP_ID=

# Must exactly match a Redirect URL configured for the app in the Deriv dashboard.
OAUTH_REDIRECT_URL=http://localhost:3000/redirect.html

# Any Postgres connection string works -- Neon, Render, Supabase, a local instance, etc.
# No code changes needed to switch providers. For local dev:
#   docker run -d --name traderpro-pg -e POSTGRES_PASSWORD=devpassword \
#     -e POSTGRES_DB=traderpro -p 5434:5432 postgres:16-alpine
DATABASE_URL=postgres://postgres:devpassword@localhost:5434/traderpro

# Copy Trading (shadow mode -- see README): which account's trades to watch.
# Leave unset for now -- real leader-trade detection isn't wired up yet, so
# this has no effect yet either way.
COPY_TRADING_LEADER_LOGINID=

# Real Trading (Rise/Fall, real money -- see README "Real Trading"). Unset
# or anything other than "true" means the /api/real-trading routes don't
# exist at all (404, not just hidden) and the frontend hides the nav
# link/page. Off by default deliberately -- this is gated behind legal
# review, not just a UI toggle.
ENABLE_REAL_TRADING=false

# Optional hard ceiling on stake per trade, enforced server-side even when
# real trading is enabled -- an extra safety margin for the pre-legal-review
# window. Leave unset for no extra cap beyond basic positive-number validation.
REAL_TRADING_MAX_STAKE=
